# Basic ignores
node_modules/

# Eval run artifacts (workspaces, grading, benchmarks, viewer HTML)
.planning/evals/*-workspace/
.planning/evals/workspace
.claude/worktrees

# Files generated by eval agents into .planning/ root
.planning/codebase/
.planning/tasks/
.planning/initial-thoughts.md
.planning/behavioral-spec.json
.planning/technical-spec.json
.planning/technical-vision.md

# Worktree copies used by eval agents
.claude/worktrees/

# Python bytecode cache
__pycache__/
